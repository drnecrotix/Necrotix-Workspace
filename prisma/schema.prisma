generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  INTAKE
  PLANNED
  ACTIVE
  REVIEW
  WAITING_CLIENT
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ClientActionStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Client {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  company   String?
  phone     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id                       String        @id @default(cuid())
  key                      String        @unique
  externalServiceRequestId String        @unique
  reference                String        @unique
  clientId                 String
  client                   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title                    String
  category                 String?
  description              String?       @db.Text
  selectedServices         Json
  requirements             Json?
  budget                   Decimal?      @db.Decimal(12, 2)
  currency                 String        @default("EUR")
  status                   ProjectStatus @default(INTAKE)
  priority                 Priority      @default(NORMAL)
  targetDate               DateTime?
  sourceUrl                String?
  tasks                    Task[]
  milestones               Milestone[]
  comments                 Comment[]
  clientActions            ClientAction[]
  attachments              Attachment[]
  accessTokens             ClientAccessToken[]
  events                   ProjectEvent[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([status, updatedAt])
  @@index([clientId, createdAt])
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title           String
  description     String?    @db.Text
  status          TaskStatus @default(BACKLOG)
  priority        Priority   @default(NORMAL)
  visibleToClient Boolean    @default(true)
  sortOrder       Int        @default(0)
  dueAt           DateTime?
  estimateMinutes Int?
  trackedMinutes  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([projectId, status, sortOrder])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PLANNED)
  sortOrder   Int             @default(0)
  dueAt       DateTime?
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId, sortOrder])
}

model Comment {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorName      String
  body            String   @db.Text
  visibleToClient Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([projectId, createdAt])
}

model ClientAction {
  id          String             @id @default(cuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?            @db.Text
  status      ClientActionStatus @default(OPEN)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([projectId, status, createdAt])
}

model Attachment {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName        String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  version         Int      @default(1)
  checksum        String?
  visibleToClient Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())

  @@unique([projectId, storageKey, version])
  @@index([projectId, createdAt])
}

model ClientAccessToken {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([projectId, expiresAt])
}

model IntegrationReceipt {
  id               String   @id @default(cuid())
  nonce            String   @unique
  serviceRequestId String   @unique
  payloadHash      String
  receivedAt       DateTime @default(now())
  expiresAt        DateTime
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
