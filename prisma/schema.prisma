generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  INTAKE
  PLANNED
  ACTIVE
  REVIEW
  WAITING_CLIENT
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Client {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  company   String?
  phone     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id                       String        @id @default(cuid())
  key                      String        @unique
  externalServiceRequestId String        @unique
  reference                String        @unique
  clientId                 String
  client                   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title                    String
  category                 String?
  description              String?       @db.Text
  selectedServices         Json
  requirements             Json?
  budget                   Decimal?      @db.Decimal(12, 2)
  currency                 String        @default("EUR")
  status                   ProjectStatus @default(INTAKE)
  priority                 Priority      @default(NORMAL)
  targetDate               DateTime?
  sourceUrl                String?
  tasks                    Task[]
  accessTokens             ClientAccessToken[]
  events                   ProjectEvent[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([status, updatedAt])
  @@index([clientId, createdAt])
}

model Task {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?    @db.Text
  status          TaskStatus @default(BACKLOG)
  priority        Priority   @default(NORMAL)
  visibleToClient Boolean    @default(true)
  sortOrder       Int        @default(0)
  dueAt           DateTime?
  estimateMinutes Int?
  trackedMinutes  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([projectId, status, sortOrder])
}

model ClientAccessToken {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([projectId, expiresAt])
}

model IntegrationReceipt {
  id               String   @id @default(cuid())
  nonce            String   @unique
  serviceRequestId String   @unique
  payloadHash      String
  receivedAt       DateTime @default(now())
  expiresAt        DateTime
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
